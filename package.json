{
	"name": "obsidian-vault-activity",
	"version": "1.1.2",
	"description": "Obsidian plugin to track your note activity stats with streak highlights and visual trend windows",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write ."
	},
	"keywords": [
		"obsidian",
		"activity",
		"stats"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^22.19.15",
		"@vitest/coverage-v8": "^4.1.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"esbuild": "0.28.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.6.0",
		"jiti": "2.7.0",
		"prettier": "^3.8.1",
		"semantic-release": "^25.0.5",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.61.0",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
